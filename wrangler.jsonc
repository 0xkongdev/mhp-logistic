{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mhp-logistic",
  "account_id": "1a1524f96e02262aa858d9e5094727b8",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
